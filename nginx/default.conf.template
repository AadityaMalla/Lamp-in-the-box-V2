# =============================================================
# Author : Aaditya Malla, Khadija Osman, Natoli Mayu
# File   : nginx/default.conf.template
# Purpose: Serve the client web page and reverse-proxy /api/ to
#          the Rocket container. ${ROCKET_HOST} is filled in from
#          an environment variable when the container starts.
# =============================================================
server {
    listen 80;
    client_max_body_size 8k;

    location / {
        root  /usr/share/nginx/html;
        index index.html;
    }

    location /api/ {
        proxy_pass http://${ROCKET_HOST}:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
}
